<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chronicle.Plugin.Kodi.NFO</AssemblyName>
    <RootNamespace>Chronicle.Plugin.Kodi.NFO</RootNamespace>
    <!-- Plugin DLL must not copy Chronicle.Plugins/Chronicle.Core into its output — both
         are provided by the host at runtime (the host process already has them loaded). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Local path reference during development, same convention as every other Chronicle
         plugin repo (sibling directory layout). Replace with a NuGet package reference once
         Chronicle.Plugins is published. Pulls in Chronicle.Core transitively (Chronicle.Plugins
         itself references it) -- that's where XmlToJsonConverter, the one genuinely
         format-agnostic piece of the old NFO code, stayed. -->
    <ProjectReference Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <PropertyGroup>
    <InternalsVisibleTo>Chronicle.Plugin.Kodi.NFO.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- Copy manifest.json to output directory so PluginHostService can read it -->
  <ItemGroup>
    <None Include="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
